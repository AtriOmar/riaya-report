@startuml use_case_doctor_secretary
left to right direction
skinparam dpi 192

actor "Visitor" as V
actor "Secretary\n(Pro practice)" as S
actor "Doctor" as D

rectangle "Riaya dashboard" {
  usecase "Sign up" as SU
  usecase "Manage bookings" as C1
  usecase "Manage patients" as C2
  usecase "Create invoices" as C3
  usecase "Update availability" as C4
  usecase "Manage medical files" as D1
  usecase "Add consultation\nrecordings" as D2
  usecase "Talk to the\nAI assistant" as D3
  usecase "Link own WhatsApp" as D4
  usecase "Invite secretaries" as D5
  usecase "Subscribe to Pro" as D6
  usecase "Authentication" as AUTH
}

V --> SU
S --> C1
S --> C2
S --> C3
S --> C4
D --> C1
D --> C2
D --> C3
D --> C4
D --> D1
D --> D2
D --> D3
D --> D4
D --> D5
D --> D6





SU -[hidden]right- D1
D1 -[hidden]right- D2
D2 -[hidden]right- D3
D3 -[hidden]right- D4
D4 -[hidden]right- D5
D5 -[hidden]right- D6
D6 -[hidden]right- C1
C1 -[hidden]right- C2
C2 -[hidden]right- C3
C3 -[hidden]right- C4

C1 ..> AUTH : <<include>>
C2 ..> AUTH : <<include>>
C3 ..> AUTH : <<include>>
C4 ..> AUTH : <<include>>
D1 ..> AUTH : <<include>>
D2 ..> AUTH : <<include>>
D3 ..> AUTH : <<include>>
D4 ..> AUTH : <<include>>
D5 ..> AUTH : <<include>>
D6 ..> AUTH : <<include>>
@enduml
