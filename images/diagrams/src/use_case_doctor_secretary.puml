@startuml use_case_doctor_secretary
left to right direction
skinparam dpi 192

actor "Secretary\n(Pro practice)" as S
actor "Doctor" as D
D --|> S

rectangle "Riaya dashboard" {
  usecase "Sign up (email OTP),\napply for verification" as D1
  usecase "Accept or refuse\nphone bookings" as C1
  usecase "Manage the calendar" as C2
  usecase "Manage patients\n(no medical files)" as C3
  usecase "Create invoices,\nrecord payments" as C4
  usecase "Send an invoice\non WhatsApp" as C5
  usecase "Set weekly\navailability" as C6
  usecase "View the dashboard" as C7
  usecase "Manage medical files,\nsend them on WhatsApp" as D2
  usecase "Record a consultation\n(transcript)" as D3
  usecase "Get an AI consultation\nnote (Pro)" as D4
  usecase "Ask the AI assistant,\nconfirm its proposals" as D5
  usecase "Link own WhatsApp\n(QR code)" as D6
  usecase "Subscribe to Pro,\nbuy recording hours" as D7
  usecase "Invite secretaries\n(Team)" as D8
  usecase "Set invoice logo\nand stamp (Pro)" as D9
}
usecase "Authentication" as AUTH

D --> D1
S --> C1
S --> C2
S --> C3
S --> C4
S --> C5
S --> C6
S --> C7
D --> D2
D --> D3
D --> D5
D --> D6
D --> D7
D --> D8
D --> D9
D4 .> D3 : <<extend>>

C1 ..> AUTH : <<include>>
C2 ..> AUTH : <<include>>
C3 ..> AUTH : <<include>>
C4 ..> AUTH : <<include>>
C5 ..> AUTH : <<include>>
C6 ..> AUTH : <<include>>
C7 ..> AUTH : <<include>>
D2 ..> AUTH : <<include>>
D3 ..> AUTH : <<include>>
D4 ..> AUTH : <<include>>
D5 ..> AUTH : <<include>>
D6 ..> AUTH : <<include>>
D7 ..> AUTH : <<include>>
D8 ..> AUTH : <<include>>
D9 ..> AUTH : <<include>>
@enduml
