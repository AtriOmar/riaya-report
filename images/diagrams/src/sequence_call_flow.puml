@startuml sequence_call_flow
skinparam dpi 192
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam ParticipantBackgroundColor white
skinparam ActorBackgroundColor white
skinparam BoundaryBackgroundColor white
skinparam ControlBackgroundColor white
skinparam EntityBackgroundColor white
skinparam QueueBackgroundColor white
skinparam SequenceGroupHeaderBackgroundColor white
hide footbox

actor "Patient" as P
participant "Twilio" as T
boundary "Call Webhook\n(Voice server)" as H
control "Call Session\n(Voice server)" as S
participant "Gemini Live" as G
boundary "API\n(Web app)" as A
entity "Appointment" as E
queue "Timeout queue\n(Redis)" as Q
participant "Google Places" as GP
boundary "Doctor Calendar\n(Web app)" as C

P -> T : dial()
T -> H : incomingCall(from)
H -> A : isBlocked(from)
A --> H : blockStatus
break number is blocked
  H --> T : reject(busy)
end
H -> A : createCall(from)
H --> T : openStream(), startRecording()
T -> S : mediaStream()
S -> A : getCallerContext(from)
A --> S : name, language, people on the line,\nlast booking place, unanswered request
S -> G : openSession(instructions, tools)
note right of G
  instructions include the current time
  in Tunisia and the caller context
end note
loop each turn, until the AI ends the call
  T -> S : callerAudio
  S -> G : callerAudio
  alt patient named a new place
    G -> S : search_location(city, place)
    S -> A : searchPlaces()
    A -> GP : search(place)
    GP --> A : coordinates
    A --> S : places
    S --> G : places
  else speciality, place and time are known
    G -> S : find_available_slots(speciality, coordinates, time)
    S -> A : findSlots()
    A -> A : keep verified doctors not\nexcluded from referrals
    A --> S : doctors, slots
    S --> G : doctors, slots
  else patient chose a doctor
    G -> S : book_appointment(doctor, slot)
    S -> A : book(place)
    A -> E : create(status = pending)
    A -> Q : add timeout job (10 min)
    A --> S : appointment
    S -> C : appointment_booked
    S --> G : request sent
  end
  G --> S : aiAudio
  S --> T : aiAudio
end
G -> S : end_call()
S -> T : hangUp()
T -> A : recordingReady(url)
@enduml
