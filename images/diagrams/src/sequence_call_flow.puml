@startuml sequence_call_flow
skinparam dpi 192
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam ParticipantBackgroundColor white
skinparam ActorBackgroundColor white
skinparam BoundaryBackgroundColor white
skinparam ControlBackgroundColor white
skinparam EntityBackgroundColor white
skinparam QueueBackgroundColor white
skinparam SequenceGroupHeaderBackgroundColor white
hide footbox

actor "Patient" as P
participant "Twilio" as T
boundary "Call Webhook\n(Voice server)" as H
control "Call Session\n(Voice server)" as S
participant "Gemini Live" as G
boundary "API\n(Web app)" as A
entity "Appointment" as E

P -> T : dial()
T -> H : incomingCall(from)
H -> A : isBlocked(from)
A --> H : blocked
alt number is blocked
  H --> T : reject(busy)
else number is allowed
  H -> A : createCall(from)
  H --> T : openStream(), startRecording()
  T -> S : mediaStream()
  S -> G : openSession(instructions, tools)
  loop each turn
    T -> S : callerAudio
    S -> G : callerAudio
    G --> S : aiAudio
    S --> T : aiAudio
  end
  G -> S : findAvailableSlots(speciality, place, time)
  S -> A : findSlots()
  A --> S : doctors, slots
  G -> S : bookAppointment(doctor, slot)
  S -> A : book()
  A -> E : create(status = pending)
  G -> S : endCall()
  S -> T : hangUp()
  T -> A : recordingReady(url)
end
@enduml
