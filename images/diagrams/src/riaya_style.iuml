' Shared Riaya diagram style (palette from the report brief)
skinparam dpi 192
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundCorner 12
skinparam defaultFontName "Helvetica Neue"
skinparam defaultFontSize 15
skinparam defaultFontColor #1F2937
skinparam ArrowColor #64748B
skinparam ArrowThickness 1.1
skinparam ArrowFontSize 15
skinparam ArrowFontColor #1F2937

skinparam sequence {
  ParticipantBackgroundColor #F0FDFA
  ParticipantBorderColor #0F766E
  ParticipantBorderThickness 1.4
  ParticipantFontStyle bold
  ParticipantFontColor #0F766E
  ParticipantPadding 2
  ActorBackgroundColor #FEF3C7
  ActorBorderColor #D97706
  ActorFontStyle bold
  LifeLineBorderColor #94A3B8
  LifeLineBackgroundColor #F0FDFA
  GroupBorderColor #94A3B8
  GroupBorderThickness 1
  GroupBackgroundColor #EEF2FF
  GroupHeaderFontColor #1F2937
  GroupFontStyle bold
  DividerBackgroundColor #EEF2FF
  DividerBorderColor #94A3B8
  DividerFontStyle bold
  BoxBorderColor #94A3B8
  MessageAlign left
}
skinparam note {
  BackgroundColor #FEF3C7
  BorderColor #D97706
  FontSize 14
}
skinparam database {
  BackgroundColor #F0FDFA
  BorderColor #0F766E
  FontStyle bold
  FontColor #0F766E
}
skinparam queue {
  BackgroundColor #F0FDFA
  BorderColor #0F766E
  FontStyle bold
  FontColor #0F766E
}
skinparam usecase {
  BackgroundColor #F0FDFA
  BorderColor #0F766E
  BorderThickness 1.2
  FontSize 15
}
skinparam actor {
  BackgroundColor #FEF3C7
  BorderColor #D97706
  FontStyle bold
  FontSize 15
}
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #94A3B8
  FontStyle bold
  FontColor #0F766E
  RoundCorner 18
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #94A3B8
  FontColor #0F766E
  FontStyle bold
}
