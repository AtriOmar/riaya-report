classDiagram
direction TB

class user {
  varchar email
  integer access_id
}
class doctor_application {
  varchar status
  varchar cin_recto, cin_verso
  varchar tin
  varchar medical_council_number
  text[] rejection_reasons
}
class doctor_profile {
  varchar status
  varchar cabinet_name
  double precision cabinet_latitude, cabinet_longitude
  jsonb availability
  varchar logo_url, stamp_url
}
class speciality {
  varchar en_name
  varchar fr_name
  varchar ar_name
}
class cities {
  double precision latitude, longitude
  varchar en_name, fr_name
}
class secretary {
  integer doctor_id
  text user_id
}
class patient {
  integer person_id
  integer doctor_id
  varchar cin
}
class consultation_recording {
  varchar audio_url
  integer duration_seconds
  jsonb transcript
  varchar transcript_status
  jsonb speaker_roles
  jsonb summary
}
class recording_usage {
  integer seconds
  integer credit_seconds
}
class ai_chat_conversation {
  varchar title
  integer recording_id
}
class ai_chat_message {
  varchar role
  jsonb parts
  varchar status
  integer cost_micro_usd
}

user "1" -- "0..*" doctor_application
user "1" -- "0..1" doctor_profile
speciality "1" -- "0..*" doctor_profile
cities "1" -- "0..*" doctor_profile
doctor_profile "1" -- "0..*" secretary
user "1" -- "0..1" secretary
doctor_profile "1" -- "0..*" consultation_recording
patient "0..1" -- "0..*" consultation_recording
consultation_recording "0..1" -- "0..1" recording_usage
doctor_profile "1" -- "0..*" ai_chat_conversation
ai_chat_conversation "0..*" -- "0..1" consultation_recording : discusses
ai_chat_conversation "1" *-- "0..*" ai_chat_message
