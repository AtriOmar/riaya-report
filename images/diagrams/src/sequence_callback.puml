@startuml sequence_callback
skinparam dpi 192
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam ParticipantBackgroundColor white
skinparam ActorBackgroundColor white
skinparam BoundaryBackgroundColor white
skinparam ControlBackgroundColor white
skinparam EntityBackgroundColor white
skinparam QueueBackgroundColor white
skinparam SequenceGroupHeaderBackgroundColor white
hide footbox

actor "Doctor" as Dr
boundary "Dashboard\n(Web app)" as UI
control "Booking Controller\n(Web app)" as B
entity "Appointment" as E
queue "Job Queue\n(Redis)" as Q
control "Callback Worker\n(Voice server)" as W
participant "Twilio" as T
actor "Patient" as P

alt doctor refuses
  Dr -> UI : refuse(request)
  UI -> B : refuse(request_id)
  B -> E : setStatus(cancelled)
  B -> Q : addJob(refused)
else no answer within 10 minutes
  Q -> Q : timeoutJobDue()
end
Q -> W : runJob(request_id)
W -> B : processJob(request_id)
B --> W : phone, message
W -> T : call(phone, mode = callback)
T -> P : ring()
alt patient answers
  W -> B : getAlternatives(request_id)
  B --> W : up to 3 other doctors
  W -> P : offerDoctors()
  P -> W : chooseDoctor()
  W -> B : book(doctor, slot)
  B -> E : create(status = pending)
else no answer, busy or failed
  T --> W : callStatus(no-answer)
  W -> P : sendWhatsApp(message)
end
@enduml
