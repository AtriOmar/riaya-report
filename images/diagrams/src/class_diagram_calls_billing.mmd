classDiagram
direction TB

class appointment {
  integer person_id
  integer patient_id
  timestamp start, end
  varchar status
}
class callrow["call"] {
  varchar call_sid
  varchar from, to
  varchar direction
  varchar status
  integer duration
  varchar recording_url
}
class call_event {
  varchar type
  text content
  varchar function_name
  jsonb function_args
  jsonb function_result
}
class call_report {
  varchar phone_number
  varchar category
  text summary
  varchar status
}
class blocked_phone {
  varchar phone_number PK
  timestamp expires_at
  integer rejected_call_count
}
class user {
  varchar name
  varchar email
  integer access_id
}
class doctor_profile {
  varchar first_name, last_name
  varchar status
  varchar cabinet_name
}
class subscription {
  varchar plan_id
  varchar status
  timestamp current_period_end
  boolean cancel_at_period_end
}
class billing_invoice {
  varchar kind
  varchar number
  varchar status
  integer amount_millimes
  integer credit_seconds
  varchar konnect_payment_ref
}
class whatsapp_usage {
  varchar period_yyyy_mm
  integer send_count
}

appointment "0..1" -- "0..*" callrow : booked during
callrow "1" *-- "0..*" call_event
callrow "1" -- "0..1" call_report
call_report "0..1" -- "0..*" blocked_phone : leads to
user "0..1" -- "0..*" call_report : reviews
user "0..1" -- "0..*" blocked_phone : blocks
doctor_profile "1" -- "0..1" subscription
doctor_profile "1" -- "0..*" billing_invoice
subscription "0..1" -- "0..*" billing_invoice
doctor_profile "1" -- "0..*" whatsapp_usage

classDef ref fill:#EEEEEE,stroke:#A3A3A3
class appointment:::ref
class user:::ref
class doctor_profile:::ref
