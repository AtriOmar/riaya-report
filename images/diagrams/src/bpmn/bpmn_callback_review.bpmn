<bpmn:collaboration id="Collab_1"><bpmn:participant id="Pool_1" name="Riaya" processRef="Process_1"/><bpmn:participant id="Pool_Patient" name="Patient (phone and WhatsApp)"/><bpmn:participant id="Pool_Doctor" name="Doctor (dashboard)"/><bpmn:messageFlow id="m0" name="accept or refuse" sourceRef="Pool_Doctor" targetRef="Pool_1"/><bpmn:messageFlow id="m1" name="WhatsApp" sourceRef="conf" targetRef="Pool_Patient"/><bpmn:messageFlow id="m2" name="rating link" sourceRef="rev" targetRef="Pool_Patient"/><bpmn:messageFlow id="m3" name="phone call" sourceRef="call" targetRef="Pool_Patient"/><bpmn:messageFlow id="m4" name="WhatsApp" sourceRef="wa" targetRef="Pool_Patient"/></bpmn:collaboration>
<bpmn:process id="Process_1" isExecutable="false"><bpmn:laneSet id="LaneSet_1"><bpmn:lane id="Lane_AI" name="AI system"><bpmn:flowNodeRef>call</bpmn:flowNodeRef><bpmn:flowNodeRef>ans</bpmn:flowNodeRef><bpmn:flowNodeRef>wa</bpmn:flowNodeRef><bpmn:flowNodeRef>endWa</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Server" name="Server and jobs"><bpmn:flowNodeRef>from</bpmn:flowNodeRef><bpmn:flowNodeRef>evgw</bpmn:flowNodeRef><bpmn:flowNodeRef>acc</bpmn:flowNodeRef><bpmn:flowNodeRef>tmo</bpmn:flowNodeRef><bpmn:flowNodeRef>ref</bpmn:flowNodeRef><bpmn:flowNodeRef>conf</bpmn:flowNodeRef><bpmn:flowNodeRef>t2h</bpmn:flowNodeRef><bpmn:flowNodeRef>rev</bpmn:flowNodeRef><bpmn:flowNodeRef>endAcc</bpmn:flowNodeRef><bpmn:flowNodeRef>cancelT</bpmn:flowNodeRef><bpmn:flowNodeRef>cancelR</bpmn:flowNodeRef><bpmn:flowNodeRef>merge</bpmn:flowNodeRef><bpmn:flowNodeRef>blk</bpmn:flowNodeRef><bpmn:flowNodeRef>endNo</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:intermediateCatchEvent id="from" name="From booking (A)"><bpmn:outgoing>g0</bpmn:outgoing><bpmn:linkEventDefinition id="from_def" name="B"></bpmn:linkEventDefinition></bpmn:intermediateCatchEvent><bpmn:eventBasedGateway id="evgw" name=""><bpmn:incoming>g0</bpmn:incoming><bpmn:outgoing>g1</bpmn:outgoing><bpmn:outgoing>g2</bpmn:outgoing><bpmn:outgoing>g3</bpmn:outgoing></bpmn:eventBasedGateway><bpmn:intermediateCatchEvent id="acc" name="Doctor accepts"><bpmn:incoming>g1</bpmn:incoming><bpmn:outgoing>g4</bpmn:outgoing><bpmn:messageEventDefinition id="acc_def"></bpmn:messageEventDefinition></bpmn:intermediateCatchEvent><bpmn:intermediateCatchEvent id="tmo" name="10 min, no answer"><bpmn:incoming>g2</bpmn:incoming><bpmn:outgoing>g8</bpmn:outgoing><bpmn:timerEventDefinition id="tmo_def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT10M</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent><bpmn:intermediateCatchEvent id="ref" name="Doctor refuses"><bpmn:incoming>g3</bpmn:incoming><bpmn:outgoing>g9</bpmn:outgoing><bpmn:messageEventDefinition id="ref_def"></bpmn:messageEventDefinition></bpmn:intermediateCatchEvent><bpmn:task id="conf" name="Confirm, link the file, WhatsApp the patient"><bpmn:incoming>g4</bpmn:incoming><bpmn:outgoing>g5</bpmn:outgoing></bpmn:task><bpmn:intermediateCatchEvent id="t2h" name="2 h after the visit"><bpmn:incoming>g5</bpmn:incoming><bpmn:outgoing>g6</bpmn:outgoing><bpmn:timerEventDefinition id="t2h_def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT2H</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent><bpmn:task id="rev" name="Send the review link"><bpmn:incoming>g6</bpmn:incoming><bpmn:outgoing>g7</bpmn:outgoing></bpmn:task><bpmn:endEvent id="endAcc" name="Review asked"><bpmn:incoming>g7</bpmn:incoming></bpmn:endEvent><bpmn:task id="cancelT" name="Cancel the request"><bpmn:incoming>g8</bpmn:incoming><bpmn:outgoing>g10</bpmn:outgoing></bpmn:task><bpmn:task id="cancelR" name="Cancel, keep the request 24 h in Redis"><bpmn:incoming>g9</bpmn:incoming><bpmn:outgoing>g11</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="merge" name=""><bpmn:incoming>g10</bpmn:incoming><bpmn:incoming>g11</bpmn:incoming><bpmn:outgoing>g12</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:exclusiveGateway id="blk" name="Blocked number?"><bpmn:incoming>g12</bpmn:incoming><bpmn:outgoing>g13</bpmn:outgoing><bpmn:outgoing>g14</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:endEvent id="endNo" name="Nothing sent"><bpmn:incoming>g13</bpmn:incoming></bpmn:endEvent><bpmn:task id="call" name="Call back: 3 other doctors or call again"><bpmn:incoming>g14</bpmn:incoming><bpmn:outgoing>g15</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="ans" name="Answered?"><bpmn:incoming>g15</bpmn:incoming><bpmn:outgoing>g16</bpmn:outgoing><bpmn:outgoing>g18</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="wa" name="WhatsApp from the platform account"><bpmn:incoming>g16</bpmn:incoming><bpmn:outgoing>g17</bpmn:outgoing></bpmn:task><bpmn:endEvent id="endWa" name="Patient informed"><bpmn:incoming>g17</bpmn:incoming><bpmn:incoming>g18</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="g0" name="" sourceRef="from" targetRef="evgw"/><bpmn:sequenceFlow id="g1" name="" sourceRef="evgw" targetRef="acc"/><bpmn:sequenceFlow id="g2" name="" sourceRef="evgw" targetRef="tmo"/><bpmn:sequenceFlow id="g3" name="" sourceRef="evgw" targetRef="ref"/><bpmn:sequenceFlow id="g4" name="" sourceRef="acc" targetRef="conf"/><bpmn:sequenceFlow id="g5" name="" sourceRef="conf" targetRef="t2h"/><bpmn:sequenceFlow id="g6" name="" sourceRef="t2h" targetRef="rev"/><bpmn:sequenceFlow id="g7" name="" sourceRef="rev" targetRef="endAcc"/><bpmn:sequenceFlow id="g8" name="" sourceRef="tmo" targetRef="cancelT"/><bpmn:sequenceFlow id="g9" name="" sourceRef="ref" targetRef="cancelR"/><bpmn:sequenceFlow id="g10" name="" sourceRef="cancelT" targetRef="merge"/><bpmn:sequenceFlow id="g11" name="" sourceRef="cancelR" targetRef="merge"/><bpmn:sequenceFlow id="g12" name="" sourceRef="merge" targetRef="blk"/><bpmn:sequenceFlow id="g13" name="yes" sourceRef="blk" targetRef="endNo"/><bpmn:sequenceFlow id="g14" name="no" sourceRef="blk" targetRef="call"/><bpmn:sequenceFlow id="g15" name="" sourceRef="call" targetRef="ans"/><bpmn:sequenceFlow id="g16" name="no" sourceRef="ans" targetRef="wa"/><bpmn:sequenceFlow id="g17" name="" sourceRef="wa" targetRef="endWa"/><bpmn:sequenceFlow id="g18" name="yes" sourceRef="ans" targetRef="endWa"/></bpmn:process>
