<bpmn:collaboration id="Collab_1"><bpmn:participant id="Pool_1" name="Riaya phone booking" processRef="Process_1"/></bpmn:collaboration>
<bpmn:process id="Process_1" isExecutable="false"><bpmn:laneSet id="LaneSet_1"><bpmn:lane id="Lane_Patient" name="Patient"><bpmn:flowNodeRef>start</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_AI" name="AI system"><bpmn:flowNodeRef>gwBlock</bpmn:flowNodeRef><bpmn:flowNodeRef>endRej</bpmn:flowNodeRef><bpmn:flowNodeRef>collect</bpmn:flowNodeRef><bpmn:flowNodeRef>abuse</bpmn:flowNodeRef><bpmn:flowNodeRef>report</bpmn:flowNodeRef><bpmn:flowNodeRef>gwUrg</bpmn:flowNodeRef><bpmn:flowNodeRef>samu</bpmn:flowNodeRef><bpmn:flowNodeRef>fit</bpmn:flowNodeRef><bpmn:flowNodeRef>gwKind</bpmn:flowNodeRef><bpmn:flowNodeRef>create</bpmn:flowNodeRef><bpmn:flowNodeRef>create3</bpmn:flowNodeRef><bpmn:flowNodeRef>gwMerge</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Doctor" name="Doctor"><bpmn:flowNodeRef>see</bpmn:flowNodeRef><bpmn:flowNodeRef>link</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Admin" name="Administrator"><bpmn:flowNodeRef>review</bpmn:flowNodeRef><bpmn:flowNodeRef>gwAdm</bpmn:flowNodeRef><bpmn:flowNodeRef>block</bpmn:flowNodeRef><bpmn:flowNodeRef>endBlock</bpmn:flowNodeRef><bpmn:flowNodeRef>endDis</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="start" name="Patient calls"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent><bpmn:exclusiveGateway id="gwBlock" name="Number blocked?"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing><bpmn:outgoing>f3</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:endEvent id="endRej" name="Rejected as busy"><bpmn:incoming>f2</bpmn:incoming></bpmn:endEvent><bpmn:task id="collect" name="Greet, ask the reason, place and time"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing></bpmn:task><bpmn:boundaryEvent id="abuse" name="Abuse" attachedToRef="collect" cancelActivity="true"><bpmn:outgoing>f4</bpmn:outgoing><bpmn:escalationEventDefinition id="abuse_def"></bpmn:escalationEventDefinition></bpmn:boundaryEvent><bpmn:task id="report" name="Report abuse, say goodbye"><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing></bpmn:task><bpmn:task id="review" name="Review report, recording and transcript"><bpmn:incoming>f5</bpmn:incoming><bpmn:outgoing>f6</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="gwAdm" name="Decision"><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing><bpmn:outgoing>f9</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="block" name="Block 7 days, 30 days or for good"><bpmn:incoming>f7</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing></bpmn:task><bpmn:endEvent id="endBlock" name="Number blocked"><bpmn:incoming>f8</bpmn:incoming></bpmn:endEvent><bpmn:endEvent id="endDis" name="Dismissed"><bpmn:incoming>f9</bpmn:incoming></bpmn:endEvent><bpmn:exclusiveGateway id="gwUrg" name="Urgent signs?"><bpmn:incoming>f10</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing><bpmn:outgoing>f12</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="samu" name="Advise SAMU 190, offer urgent requests"><bpmn:incoming>f12</bpmn:incoming><bpmn:outgoing>f13</bpmn:outgoing></bpmn:task><bpmn:task id="fit" name="Best-fit search, offer 2 to 3 doctors"><bpmn:incoming>f11</bpmn:incoming><bpmn:incoming>f13</bpmn:incoming><bpmn:outgoing>f14</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="gwKind" name="Urgent?"><bpmn:incoming>f14</bpmn:incoming><bpmn:outgoing>f15</bpmn:outgoing><bpmn:outgoing>f16</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="create" name="Create a pending request"><bpmn:incoming>f15</bpmn:incoming><bpmn:outgoing>f17</bpmn:outgoing></bpmn:task><bpmn:task id="create3" name="Create up to 3 urgent requests, one group"><bpmn:incoming>f16</bpmn:incoming><bpmn:outgoing>f18</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="gwMerge" name=""><bpmn:incoming>f17</bpmn:incoming><bpmn:incoming>f18</bpmn:incoming><bpmn:outgoing>f19</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="see" name="See the request live, urgent badge"><bpmn:incoming>f19</bpmn:incoming><bpmn:outgoing>f20</bpmn:outgoing></bpmn:task><bpmn:intermediateThrowEvent id="link" name="To answer flow (B)"><bpmn:incoming>f20</bpmn:incoming><bpmn:linkEventDefinition id="link_def" name="B"></bpmn:linkEventDefinition></bpmn:intermediateThrowEvent><bpmn:sequenceFlow id="f1" name="" sourceRef="start" targetRef="gwBlock"/><bpmn:sequenceFlow id="f2" name="yes" sourceRef="gwBlock" targetRef="endRej"/><bpmn:sequenceFlow id="f3" name="no" sourceRef="gwBlock" targetRef="collect"/><bpmn:sequenceFlow id="f4" name="" sourceRef="abuse" targetRef="report"/><bpmn:sequenceFlow id="f5" name="" sourceRef="report" targetRef="review"/><bpmn:sequenceFlow id="f6" name="" sourceRef="review" targetRef="gwAdm"/><bpmn:sequenceFlow id="f7" name="block" sourceRef="gwAdm" targetRef="block"/><bpmn:sequenceFlow id="f8" name="" sourceRef="block" targetRef="endBlock"/><bpmn:sequenceFlow id="f9" name="dismiss" sourceRef="gwAdm" targetRef="endDis"/><bpmn:sequenceFlow id="f10" name="" sourceRef="collect" targetRef="gwUrg"/><bpmn:sequenceFlow id="f11" name="no" sourceRef="gwUrg" targetRef="fit"/><bpmn:sequenceFlow id="f12" name="yes" sourceRef="gwUrg" targetRef="samu"/><bpmn:sequenceFlow id="f13" name="" sourceRef="samu" targetRef="fit"/><bpmn:sequenceFlow id="f14" name="" sourceRef="fit" targetRef="gwKind"/><bpmn:sequenceFlow id="f15" name="no" sourceRef="gwKind" targetRef="create"/><bpmn:sequenceFlow id="f16" name="yes" sourceRef="gwKind" targetRef="create3"/><bpmn:sequenceFlow id="f17" name="" sourceRef="create" targetRef="gwMerge"/><bpmn:sequenceFlow id="f18" name="" sourceRef="create3" targetRef="gwMerge"/><bpmn:sequenceFlow id="f19" name="" sourceRef="gwMerge" targetRef="see"/><bpmn:sequenceFlow id="f20" name="" sourceRef="see" targetRef="link"/></bpmn:process>
