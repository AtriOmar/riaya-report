  boolean sent_via_whatsapp
}
class invoice {
  varchar number
  varchar status
  integer total_centimes
  integer amount_paid_centimes
}
class invoice_item {
  varchar description
  integer quantity
  integer unit_price_centimes
}
class invoice_payment {
  integer amount_centimes
  varchar payment_method
  timestamp paid_at
}

