class doctor_profile {
  varchar first_name, last_name
  varchar status
  varchar cabinet_name
}
class person {
  varchar first_name, last_name
  timestamp date_of_birth
  varchar preferred_language
  varchar source
}
class person_phone {
  integer person_id
  varchar phone_number
  varchar relationship
}
class patient {
  integer person_id
  integer doctor_id
  varchar cin
  varchar phone_number
}
class appointment {
  integer person_id
  integer patient_id
  varchar contact_phone
  timestamp start, end
  varchar status
  varchar source
  boolean urgent
  varchar emergency_group_id
}
class review {
  varchar token
  integer rating
  varchar wait_time
}
class consultation {
  timestamp date
  varchar title
}
class patient_medical_file {
  varchar type
  varchar title
