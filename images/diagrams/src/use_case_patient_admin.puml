@startuml use_case_patient_admin
left to right direction
skinparam dpi 192

actor "Patient\n(phone, WhatsApp)" as P
actor "Administrator" as A

rectangle "Phone assistant and WhatsApp" {
  usecase "Book an appointment" as P1
  usecase "List or cancel\npending appointments" as P4
  usecase "Rate a doctor\n(from a link)" as P5
}
rectangle "Admin area" {
  usecase "Authentication" as AUTH

  usecase "Manage doctor\napplications" as A1
  usecase "Monitor live AI calls\nand bookings" as A2
  usecase "Manage reports and\nblocked numbers" as A3
  usecase "Manage users" as A4
  usecase "Manage specialities" as A5
}

P --> P1
P --> P4
P --> P5

A --> A1
A --> A2
A --> A3
A --> A4
A --> A5

A1 ..> AUTH : <<include>>
A2 ..> AUTH : <<include>>
A3 ..> AUTH : <<include>>
A4 ..> AUTH : <<include>>
A5 ..> AUTH : <<include>>
@enduml
